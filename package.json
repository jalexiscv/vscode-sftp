          "when": "false"
        },
        {
          "command": "sftp.delete.remote",
          "when": "false"
        },
        {
          "command": "sftp.create.folder",
          "when": "false"
        },
        {
          "command": "sftp.create.file",
          "when": "false"
        },
        {
          "command": "sftp.revealInExplorer",
          "when": "false"
        },
        {
          "command": "sftp.revealInRemoteExplorer",
          "when": "false"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "when": "false"
        },
        {
          "command": "sftp.viewContent",
          "when": "false"
        },
        {
          "command": "sftp.remoteExplorer.refresh",
          "when": "false"
        },
        {
          "command": "sftp.plan.preview",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.plan.uploadAll",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.plan.exportReport",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.plan.clearAll",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.plan.markUploaded",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.plan.uploadItem",
          "when": "false"
        },
        {
          "command": "sftp.plan.skipItem",
